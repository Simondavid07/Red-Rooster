{
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.13",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  },
  "name": "red-rooster",
  "packageManager": "bun@1.3.10",
  "private": true,
  "scripts": {
    "build": "bun run build:client",
    "build:client": "bun ./client/build.mjs",
    "dev": "bun run build:client && bun run server/src/index.ts",
    "start": "bun run server/src/index.ts",
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json"
  },
  "type": "module"
}